// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BookDemoPage snapshot 1`] = `
<div>
  <div
    class="book-demo-page"
  >
    <div
      class="book-demo-main"
    >
      <div
        class="book-demo-image-section"
      >
        <img
          alt="Demo illustration"
          class="book-demo-image"
          src="/src/assets/images/registerImage.jpg"
        />
      </div>
      <div
        class="book-demo-content-section"
      >
        <div
          class="book-demo-content-wrapper"
        >
          <div
            class="book-demo-form-card"
          >
            <h2
              class="book-demo-title"
            >
              Book a Demo
            </h2>
            <p
              class="book-demo-subtitle"
            >
              Schedule a call with our team to explore SME BIM Automation Toolkit.
            </p>
            <div
              class="login-prompt-top"
            >
              <p>
                Already have an account? 
                <a
                  class="login-link"
                  data-discover="true"
                  href="/login"
                >
                  Sign in here
                </a>
              </p>
            </div>
            <form
              class="book-demo-form"
            >
              <div
                class="form-group"
              >
                <label
                  class="form-label"
                  for="requestType"
                >
                  Request type *
                </label>
                <select
                  class="form-input "
                  id="requestType"
                  name="requestType"
                  required=""
                >
                  <option
                    value=""
                  >
                    Select a request type
                  </option>
                  <option
                    value="book-demo"
                  >
                    Book a Demo
                  </option>
                  <option
                    value="compliance-validation"
                  >
                    Compliance Validation
                  </option>
                  <option
                    value="request-a-trial"
                  >
                    Request a Trial
                  </option>
                  <option
                    value="general-inquiry"
                  >
                    General Inquiry
                  </option>
                  <option
                    value="others"
                  >
                    Others
                  </option>
                </select>
              </div>
              <div
                class="form-row"
              >
                <div
                  class="form-group"
                >
                  <label
                    class="form-label"
                    for="firstName"
                  >
                    First name *
                  </label>
                  <input
                    class="form-input "
                    id="firstName"
                    name="firstName"
                    placeholder="John"
                    required=""
                    type="text"
                    value=""
                  />
                </div>
                <div
                  class="form-group"
                >
                  <label
                    class="form-label"
                    for="lastName"
                  >
                    Last name *
                  </label>
                  <input
                    class="form-input "
                    id="lastName"
                    name="lastName"
                    placeholder="Doe"
                    required=""
                    type="text"
                    value=""
                  />
                </div>
              </div>
              <div
                class="form-group"
              >
                <label
                  class="form-label"
                  for="email"
                >
                  Email *
                </label>
                <input
                  class="form-input "
                  id="email"
                  name="email"
                  placeholder="john@bimflow.dev"
                  required=""
                  type="email"
                  value=""
                />
              </div>
              <div
                class="form-group"
              >
                <label
                  class="form-label"
                  for="country"
                >
                  Country *
                </label>
                <input
                  class="form-input "
                  id="country"
                  name="country"
                  placeholder="United States"
                  required=""
                  type="text"
                  value=""
                />
              </div>
              <div
                class="form-group"
              >
                <label
                  class="form-label"
                  for="company"
                >
                  Company name *
                </label>
                <input
                  class="form-input "
                  id="company"
                  name="company"
                  placeholder="Your Company Ltd."
                  required=""
                  type="text"
                  value=""
                />
              </div>
              <div
                class="form-group"
              >
                <label
                  class="form-label"
                  for="jobTitle"
                >
                  Job title *
                </label>
                <input
                  class="form-input "
                  id="jobTitle"
                  name="jobTitle"
                  placeholder="BIM Manager"
                  required=""
                  type="text"
                  value=""
                />
              </div>
              <div
                class="form-group"
              >
                <label
                  class="form-label"
                  for="phone"
                >
                  Phone number *
                </label>
                <input
                  class="form-input "
                  id="phone"
                  name="phone"
                  placeholder="+1 123 456 7890"
                  required=""
                  type="tel"
                  value=""
                />
                <small
                  class="form-note"
                >
                  Enter your phone number, including the country code
                </small>
              </div>
              <div
                class="form-group"
              >
                <label
                  class="form-label"
                  for="additionalInfo"
                >
                  Additional information
                </label>
                <textarea
                  class="form-input"
                  id="additionalInfo"
                  name="additionalInfo"
                  placeholder="Tell us more about your needs..."
                  rows="4"
                />
              </div>
              <div
                class="consent-group"
              >
                <label
                  class="consent-label"
                >
                  <input
                    name="communications"
                    required=""
                    type="checkbox"
                  />
                  <span>
                    I consent to receive communications from SME BIM Automation Toolkit entities and their partners according to Sections 4.1 (g) and 4.1 (i) and to the transfer of my personal data to SME BIM Automation Toolkit’s partners according to Section 4.1 (g) of the Privacy Policy.
                  </span>
                </label>
                <label
                  class="consent-label"
                >
                  <input
                    name="marketing"
                    type="checkbox"
                  />
                  <span>
                    I agree to receive marketing communications from SME BIM Automation Toolkit.
                  </span>
                </label>
                <p
                  class="consent-note"
                >
                  You may unsubscribe from these communications at any time. For more information on how to unsubscribe, our privacy practices, and how we are committed to protecting and respecting your privacy, please review our 
                  <a
                    class="privacy-link"
                    data-discover="true"
                    href="/privacy-policy"
                  >
                    Privacy Policy
                  </a>
                  .
                </p>
                <p
                  class="consent-disclaimer"
                >
                  By clicking submit below, you consent to allow smebimautomationtoolkit.com to store and process the personal information submitted above to provide you the content requested.
                </p>
              </div>
              <button
                class="book-demo-btn"
                type="submit"
              >
                Submit
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
