// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`LoginPage > matches snapshot 1`] = `
<div>
  <div
    class="login-page"
  >
    <div
      class="login-main"
    >
      <div
        class="login-image-section"
      >
        <img
          alt="Secure login illustration"
          class="login-image"
          src="/src/assets/images/loginImage2.jpg"
        />
      </div>
      <div
        class="login-content-section"
      >
        <div
          class="login-content-wrapper"
        >
          <div
            class="login-form-card"
          >
            <h2
              class="login-title"
            >
              Welcome Back
            </h2>
            <p
              class="login-subtitle"
            >
              Sign in to your BIMFlow Suite account to access your projects and tools.
            </p>
            <form
              class="login-form"
            >
              <div
                class="form-group"
              >
                <label
                  class="form-label"
                  for="identifier"
                >
                  Email or Username *
                </label>
                <input
                  aria-invalid="false"
                  autocomplete="username"
                  class="form-input "
                  id="identifier"
                  name="identifier"
                  placeholder="Enter your email or username"
                  type="text"
                  value=""
                />
              </div>
              <div
                class="form-group"
              >
                <label
                  class="form-label"
                  for="password"
                >
                  Password *
                </label>
                <div
                  class="password-wrapper"
                >
                  <input
                    aria-invalid="false"
                    autocomplete="current-password"
                    class="form-input "
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    type="password"
                    value=""
                  />
                </div>
                <a
                  class="forgot-password"
                  data-discover="true"
                  href="/forgot-password"
                >
                  Forgot your password?
                </a>
              </div>
              <button
                class="login-btn"
                type="submit"
              >
                Sign In
              </button>
            </form>
            <div
              class="divider"
            >
              <span>
                or
              </span>
            </div>
            <div
              class="signup-prompt"
            >
              <p>
                Don't have an account?
                 
                <a
                  class="signup-link"
                  data-discover="true"
                  href="/book-demo"
                >
                  Book a demo here
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
