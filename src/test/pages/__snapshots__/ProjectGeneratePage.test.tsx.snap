        >
          <span
            class="nav-number"
          >
            1
          </span>
          <span
            class="nav-text"
          >
            Basics
          </span>
        </button>
        <button
          class="section-nav-btn "
        >
          <span
            class="nav-number"
          >
            2
          </span>
          <span
            class="nav-text"
          >
            Site
          </span>
        </button>
        <button
          class="section-nav-btn "
        >
          <span
