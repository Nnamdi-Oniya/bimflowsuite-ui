            >
              📋
            </span>
            Project Basics
          </h3>
          <div
            class="form-grid"
          >
            <div
              class="form-group"
            >
              <label
                class="form-label required"
              >
                Project Name
              </label>
              <input
                class="form-input "
                placeholder="e.g. Victoria Island Tower"
                value=""
              />
            </div>
            <div
              class="form-group"
            >
              <label
                class="form-label required"
              >
                Project Type
              </label>
              <select
                class="form-select "
              >
                <option
                  value=""
                >
                  Select project type
                </option>
                <option
                  value="IFC_BUILDING"
                >
                  🏢 Building
                </option>
                <option
                  value="IFC_ROAD"
                >
                  🛣️ Road
                </option>
                <option
                  value="IFC_RAILWAY"
                >
                  🚄 Railway
                </option>
                <option
                  value="IFC_BRIDGE"
                >
                  🌉 Bridge
                </option>
                <option
                  value="IFC_TUNNEL"
                >
                  🚇 Tunnel
                </option>
                <option
                  value="IFC_MARINE_FACILITY"
                >
                  ⚓ Marine Facility
                </option>
                <option
                  value="IFC_FACTORY"
                >
                  🏭 Factory
                </option>
                <option
                  value="IFC_PROCESS_PLANT"
                >
                  🧪 Process Plant
                </option>
                <option
                  value="IFC_DISTRIBUTION_SYSTEM"
                >
                  🔌 Distribution System
                </option>
                <option
                  value="IFC_SITE"
                >
                  🌍 Site / Land
                </option>
                <option
                  value="OTHER"
                >
                  ❓ Other / Custom
                </option>
              </select>
            </div>
            <div
              class="form-group full-width"
            >
              <label
                class="form-label required"
              >
                Description
              </label>
              <textarea
                class="form-textarea "
                placeholder="Purpose, scope, size, special notes..."
                rows="5"
              />
              <div
                class="character-count"
              >
                0
                 / 1200
              </div>
            </div>
          </div>
          <div
            class="form-section-navigation"
          >
            <button
              class="btn btn--secondary"
