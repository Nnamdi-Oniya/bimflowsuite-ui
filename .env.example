# Vite uses VITE_ prefix
VITE_APP_ENV=your-enviroment(production, development, local)
VITE_BACKEND_URL=https://your-backend-url
VITE_API_PREFIX=/api/v1
VITE_DEBUG=false
VITE_APP_VERSION=1.0.0
VITE_FRONTEND_URL=your-frontend-url

# Optional: Keep REACT_APP_ for backward compatibility if needed
REACT_APP_ENV=your-enviroment(production, development, local)
REACT_APP_BACKEND_URL=https://your-backend-url
REACT_APP_API_PREFIX=/api/v1
REACT_APP_DEBUG=false
REACT_APP_VERSION=1.0.0